	"description": "WooCommerce plugin",
	"autoload": {
		"psr-4": {
			"WooAuthorizeNetGatewayEnterprise\\": "includes/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"automattic/jetpack-autoloader": "^2",
		"brain/monkey": "^2.6"
	},
	"autoload-dev": {
